# YourBot Backend Environment Variables
# Copy this file to .env and update with your actual values

# Security - REQUIRED in production!
# Generate a secure secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-in-production-DO-NOT-USE-IN-PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database - PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://yourbot_user:yourbot_password@localhost:5432/yourbot_db

# CORS - Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080

# Email Verification
EMAIL_VERIFICATION_REQUIRED=false

# MinIO S3-Compatible Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=yourbot_minio_admin
MINIO_SECRET_KEY=yourbot_minio_password
MINIO_SECURE=false
MINIO_BUCKET_NAME=yourbot-documents


# Admin Configuration
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
ADMIN_ALLOW_ANY_CREDENTIALS=True
